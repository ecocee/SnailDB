{
  "name": "ecocee",
  "version": "1.0.0",
  "description": "ECOCEE: Production-Grade, AI-Optimized Custom Database Engine with Vector Search, Custom SQL Parser, Storage Engine, and SuperMemory™ AI Module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "ecoceedb": "./dist/cmd/ecoceedb/main.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "ts-node cmd/ecoceedb/main.ts",
    "start": "node dist/cmd/ecoceedb/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts cmd/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"cmd/**/*.ts\"",
    "clean": "rimraf dist",
    "server": "ts-node cmd/ecoceedb/server.ts",
    "shell": "ts-node cmd/ecoceedb/shell.ts",
    "benchmark": "ts-node cmd/ecoceedb/benchmark.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "database",
    "vector-search",
    "ai",
    "typescript",
    "embedded",
    "hnsw",
    "ivf",
    "custom-sql",
    "storage-engine",
    "in-memory",
    "persistence",
    "rag",
    "embeddings",
    "ai-agents"
  ],
  "author": "ECOCEE Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "uuid": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberkutti-iedc/ecocee"
  }
}
